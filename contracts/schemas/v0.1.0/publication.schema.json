{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.universal-agent.studio/v0.1.0/publication.schema.json",
  "title": "PublicationState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent_id",
    "draft_revision",
    "draft_digest",
    "active_version_id",
    "versions",
    "events",
    "api_keys",
    "webhooks"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "agent_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "draft_revision": {
      "type": "integer",
      "minimum": 1
    },
    "draft_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "active_version_id": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "versions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PublishedVersionView"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PublicationEventView"
      }
    },
    "api_keys": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ApiKeyView"
      }
    },
    "webhooks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WebhookView"
      }
    }
  },
  "$defs": {
    "ApiKeyScope": {
      "enum": [
        "runs:create",
        "runs:read",
        "events:read"
      ]
    },
    "PublishedVersionView": {
      "title": "PublishedVersionView",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_id",
        "version_number",
        "digest",
        "created_at"
      ],
      "properties": {
        "version_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "version_number": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "PublicationEventView": {
      "title": "PublicationEventView",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "previous_version_id",
        "selected_version_id",
        "selected_version_digest",
        "created_at"
      ],
      "properties": {
        "event_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "event_type": {
          "enum": [
            "publish",
            "rollback"
          ]
        },
        "previous_version_id": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_version_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "selected_version_digest": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "PublishRequest": {
      "title": "PublishRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_draft_revision",
        "expected_active_version_id"
      ],
      "properties": {
        "expected_draft_revision": {
          "type": "integer",
          "minimum": 1
        },
        "expected_active_version_id": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RollbackRequest": {
      "title": "RollbackRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_version_id",
        "expected_active_version_id"
      ],
      "properties": {
        "target_version_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "expected_active_version_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        }
      }
    },
    "ApiKeyCreateRequest": {
      "title": "ApiKeyCreateRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "scopes",
        "expires_at"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ApiKeyScope"
          }
        },
        "expires_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ApiKeyView": {
      "title": "ApiKeyView",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "label",
        "prefix",
        "scopes",
        "expires_at",
        "created_at",
        "last_used_at",
        "revoked_at"
      ],
      "properties": {
        "key_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "label": {
          "type": "string"
        },
        "prefix": {
          "type": "string",
          "pattern": "^[a-f0-9]{16}$"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ApiKeyScope"
          }
        },
        "expires_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_used_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "revoked_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ApiKeyCreateView": {
      "title": "ApiKeyCreateView",
      "allOf": [
        {
          "$ref": "#/$defs/ApiKeyView"
        },
        {
          "type": "object",
          "required": [
            "secret"
          ],
          "properties": {
            "secret": {
              "type": "string",
              "pattern": "^uas_live_[a-f0-9]{16}_[A-Za-z0-9_-]{43}$"
            }
          }
        }
      ]
    },
    "WebhookEventType": {
      "enum": [
        "run.completed",
        "run.failed",
        "run.cancelled"
      ]
    },
    "WebhookCreateRequest": {
      "title": "WebhookCreateRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "target_url",
        "events"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "target_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/WebhookEventType"
          }
        }
      }
    },
    "WebhookView": {
      "title": "WebhookView",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subscription_id",
        "label",
        "target_url",
        "events",
        "created_at",
        "revoked_at"
      ],
      "properties": {
        "subscription_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "label": {
          "type": "string"
        },
        "target_url": {
          "type": "string",
          "format": "uri"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/WebhookEventType"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "revoked_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "WebhookCreateView": {
      "title": "WebhookCreateView",
      "allOf": [
        {
          "$ref": "#/$defs/WebhookView"
        },
        {
          "type": "object",
          "required": [
            "secret"
          ],
          "properties": {
            "secret": {
              "type": "string",
              "pattern": "^whsec_[A-Za-z0-9_-]{43}$"
            }
          }
        }
      ]
    }
  }
}
