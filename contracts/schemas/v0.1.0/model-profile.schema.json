{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.universal-agent.studio/v0.1.0/model-profile.schema.json",
  "title": "ModelProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "localized_metadata",
    "required_capabilities",
    "routes",
    "parameters",
    "data_policy",
    "extensions"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "localized_metadata": {
      "$ref": "common.schema.json#/$defs/localizedMetadata"
    },
    "required_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "text",
          "structured_output",
          "tool_calling",
          "vision",
          "embeddings"
        ]
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "parameters": {
      "$ref": "#/$defs/parameters"
    },
    "data_policy": {
      "$ref": "#/$defs/dataPolicy"
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "model"
      ],
      "properties": {
        "adapter": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "credential_ref": {
          "$ref": "common.schema.json#/$defs/identifier"
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature",
        "max_output_tokens"
      ],
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      }
    },
    "dataPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_allowed",
        "sensitive_data_allowed",
        "retention_policy",
        "regions"
      ],
      "properties": {
        "external_allowed": {
          "type": "boolean"
        },
        "sensitive_data_allowed": {
          "type": "boolean"
        },
        "retention_policy": {
          "enum": [
            "none",
            "provider-default",
            "contractual-zero-retention"
          ]
        },
        "regions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        }
      }
    }
  }
}
