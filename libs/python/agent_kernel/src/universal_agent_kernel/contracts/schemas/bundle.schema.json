          ],
          "type": "object"
        },
        "extensions": {
          "additionalProperties": {
            "type": "object"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
          },
          "type": "object"
        },
        "identifier": {
          "pattern": "^[a-z][a-z0-9_-]{2,63}$",
          "type": "string"
        },
        "localizedMetadata": {
          "additionalProperties": false,
          "properties": {
            "description": {
              "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/localizedText"
