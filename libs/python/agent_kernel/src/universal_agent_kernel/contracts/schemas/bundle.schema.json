{
  "$defs": {
    "AgentSpec": {
      "$defs": {
        "edge": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
            },
            "source": {
              "$ref": "#/$defs/AgentSpec/$defs/endpoint"
            },
            "target": {
              "$ref": "#/$defs/AgentSpec/$defs/endpoint"
            }
          },
          "required": [
            "id",
            "source",
            "target"
          ],
          "type": "object"
        },
        "endpoint": {
          "additionalProperties": false,
          "properties": {
            "node_id": {
              "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
            },
            "port_id": {
              "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
            }
          },
          "required": [
            "node_id",
            "port_id"
          ],
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/AgentSpec/$defs/edge"
          },
          "type": "array"
        },
        "extensions": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/extensions"
        },
        "interface": {
          "$ref": "#/$defs/InterfaceSchema"
        },
        "localized_metadata": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/localizedMetadata"
        },
        "model_profiles": {
          "items": {
            "$ref": "#/$defs/ModelProfile"
          },
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/NodeSpec"
          },
          "minItems": 1,
          "type": "array"
        },
        "policies": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/policySet"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "schema_version": {
          "const": "0.1.0"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/ToolManifest"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "agent_id",
        "revision",
        "localized_metadata",
        "nodes",
        "edges",
        "model_profiles",
        "tools",
        "interface",
        "policies",
        "extensions"
      ],
      "title": "AgentSpec",
      "type": "object"
    },
    "AgentVersion": {
      "$defs": {
        "dependency": {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/sha256"
            },
            "id": {
              "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
            },
            "kind": {
              "enum": [
                "model_adapter",
                "tool",
                "asset",
                "capability_pack"
              ]
            },
            "version": {
              "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/semver"
            }
          },
          "required": [
            "kind",
            "id",
            "version",
            "digest"
          ],
          "type": "object"
        },
        "signature": {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "ed25519"
            },
            "key_id": {
              "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
            },
            "value": {
              "minLength": 32,
              "type": "string"
            }
          },
          "required": [
            "algorithm",
            "key_id",
            "value"
          ],
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
        },
        "agent_spec": {
          "$ref": "#/$defs/AgentSpec"
        },
        "agent_spec_digest": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/sha256"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "dependency_lock": {
          "items": {
            "$ref": "#/$defs/AgentVersion/$defs/dependency"
          },
          "type": "array"
        },
        "schema_version": {
          "const": "0.1.0"
        },
        "signature": {
          "$ref": "#/$defs/AgentVersion/$defs/signature"
        },
        "status": {
          "const": "published"
        },
        "version_id": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
        },
        "version_number": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "version_id",
        "agent_id",
        "version_number",
        "status",
        "agent_spec",
        "agent_spec_digest",
        "dependency_lock",
        "created_at"
      ],
      "title": "AgentVersion",
      "type": "object"
    },
    "ErrorEnvelope": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "type": "string"
        },
        "details": {
          "type": "object"
        },
        "message_key": {
          "pattern": "^[a-z][a-z0-9_.]{2,127}$",
          "type": "string"
        },
        "node_id": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message_key",
        "retryable",
        "details"
      ],
      "title": "ErrorEnvelope",
      "type": "object"
    },
    "InterfaceSchema": {
      "$defs": {
        "inputField": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
            },
            "label": {
              "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/localizedText"
            },
            "required": {
              "type": "boolean"
            },
            "schema": {
              "type": "object"
            }
          },
          "required": [
            "id",
            "label",
            "schema",
            "required"
          ],
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "default_locale": {
          "enum": [
            "ru-RU",
            "en-US"
          ]
        },
        "input_fields": {
          "items": {
            "$ref": "#/$defs/InterfaceSchema/$defs/inputField"
          },
          "type": "array"
        },
        "locales": {
          "contains": {
            "const": "ru-RU"
          },
          "items": {
            "enum": [
              "ru-RU",
              "en-US"
            ]
          },
          "minItems": 2,
          "type": "array",
          "uniqueItems": true
        },
        "mode": {
          "enum": [
            "form",
            "chat",
            "hybrid"
          ]
        },
        "result_schema": {
          "type": "object"
        }
      },
      "required": [
        "mode",
        "locales",
        "default_locale",
        "input_fields",
        "result_schema"
      ],
      "title": "InterfaceSchema",
      "type": "object"
    },
    "ModelProfile": {
      "$defs": {
        "dataPolicy": {
          "additionalProperties": false,
          "properties": {
            "external_allowed": {
              "type": "boolean"
            },
            "regions": {
              "items": {
                "pattern": "^[A-Z]{2}$",
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "retention_policy": {
              "enum": [
                "none",
                "provider-default",
                "contractual-zero-retention"
              ]
            },
            "sensitive_data_allowed": {
              "type": "boolean"
            }
          },
          "required": [
            "external_allowed",
            "sensitive_data_allowed",
            "retention_policy",
            "regions"
          ],
          "type": "object"
        },
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "max_output_tokens": {
              "maximum": 1048576,
              "minimum": 1,
              "type": "integer"
            },
            "temperature": {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            }
          },
          "required": [
            "temperature",
            "max_output_tokens"
          ],
          "type": "object"
        },
        "route": {
          "additionalProperties": false,
          "properties": {
            "adapter": {
              "pattern": "^[a-z][a-z0-9-]{1,63}$",
              "type": "string"
            },
            "credential_ref": {
              "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
            },
            "model": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "adapter",
            "model"
          ],
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "data_policy": {
          "$ref": "#/$defs/ModelProfile/$defs/dataPolicy"
        },
        "extensions": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/extensions"
        },
        "id": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
        },
        "localized_metadata": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/localizedMetadata"
        },
        "parameters": {
          "$ref": "#/$defs/ModelProfile/$defs/parameters"
        },
        "required_capabilities": {
          "items": {
            "enum": [
              "text",
              "structured_output",
              "tool_calling",
              "vision",
              "embeddings"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "routes": {
          "items": {
            "$ref": "#/$defs/ModelProfile/$defs/route"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "id",
        "localized_metadata",
        "required_capabilities",
        "routes",
        "parameters",
        "data_policy",
        "extensions"
      ],
      "title": "ModelProfile",
      "type": "object"
    },
    "NodeSpec": {
      "$defs": {
        "port": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
            },
            "schema": {
              "type": "object"
            }
          },
          "required": [
            "id",
            "schema"
          ],
          "type": "object"
        },
        "retryPolicy": {
          "additionalProperties": false,
          "properties": {
            "backoff": {
              "enum": [
                "none",
                "fixed",
                "exponential"
              ]
            },
            "max_attempts": {
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "max_attempts",
            "backoff"
          ],
          "type": "object"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "model"
              }
            }
          },
          "then": {
            "properties": {
              "model_profile_ref": {
                "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
              }
            },
            "required": [
              "model_profile_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tool"
              }
            }
          },
          "then": {
            "properties": {
              "tool_ref": {
                "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
              }
            },
            "required": [
              "tool_ref"
            ]
          }
        }
      ],
      "properties": {
        "config": {
          "type": "object"
        },
        "extensions": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/extensions"
        },
        "id": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
        },
        "input_ports": {
          "items": {
            "$ref": "#/$defs/NodeSpec/$defs/port"
          },
          "type": "array"
        },
        "kind": {
          "enum": [
            "input",
            "model",
            "tool",
            "output"
          ]
        },
        "localized_metadata": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/localizedMetadata"
        },
        "model_profile_ref": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
        },
        "output_ports": {
          "items": {
            "$ref": "#/$defs/NodeSpec/$defs/port"
          },
          "type": "array"
        },
        "retry_policy": {
          "$ref": "#/$defs/NodeSpec/$defs/retryPolicy"
        },
        "timeout_ms": {
          "maximum": 3600000,
          "minimum": 1,
          "type": "integer"
        },
        "tool_ref": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
        },
        "type": {
          "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$",
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/semver"
        }
      },
      "required": [
        "id",
        "kind",
        "type",
        "version",
        "localized_metadata",
        "config",
        "input_ports",
        "output_ports",
        "timeout_ms",
        "retry_policy",
        "extensions"
      ],
      "title": "NodeSpec",
      "type": "object"
    },
    "RunEvent": {
      "additionalProperties": false,
      "properties": {
        "causation_id": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/uuid"
        },
        "correlation_id": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/uuid"
        },
        "error": {
          "$ref": "#/$defs/ErrorEnvelope"
        },
        "event_id": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/uuid"
        },
        "node_id": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
        },
        "occurred_at": {
          "format": "date-time",
          "type": "string"
        },
        "payload": {
          "type": "object"
        },
        "redaction_policy_id": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
        },
        "run_id": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/uuid"
        },
        "schema_version": {
          "const": "0.1.0"
        },
        "sequence": {
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "enum": [
            "run.started",
            "node.started",
            "model.requested",
            "model.completed",
            "tool.requested",
            "tool.completed",
            "approval.required",
            "approval.resolved",
            "node.failed",
            "node.completed",
            "run.completed",
            "run.failed",
            "run.cancelled"
          ]
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "run_id",
        "sequence",
        "type",
        "occurred_at",
        "correlation_id",
        "causation_id",
        "redaction_policy_id",
        "payload"
      ],
      "title": "RunEvent",
      "type": "object"
    },
    "RunRequest": {
      "additionalProperties": false,
      "properties": {
        "agent_version_digest": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/sha256"
        },
        "agent_version_id": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
        },
        "idempotency_key": {
          "pattern": "^[A-Za-z0-9._:-]{16,128}$",
          "type": "string"
        },
        "input": {
          "type": "object"
        },
        "locale": {
          "enum": [
            "ru-RU",
            "en-US"
          ]
        },
        "request_id": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/uuid"
        },
        "schema_version": {
          "const": "0.1.0"
        },
        "session_id": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/uuid"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "agent_version_id",
        "agent_version_digest",
        "idempotency_key",
        "input",
        "locale"
      ],
      "title": "RunRequest",
      "type": "object"
    },
    "RunTrace": {
      "$defs": {
        "metrics": {
          "additionalProperties": false,
          "properties": {
            "cost": {
              "additionalProperties": false,
              "properties": {
                "amount": {
                  "minimum": 0,
                  "type": "number"
                },
                "currency": {
                  "pattern": "^[A-Z]{3}$",
                  "type": "string"
                }
              },
              "required": [
                "amount",
                "currency"
              ],
              "type": "object"
            },
            "duration_ms": {
              "minimum": 0,
              "type": "integer"
            },
            "input_tokens": {
              "minimum": 0,
              "type": "integer"
            },
            "output_tokens": {
              "minimum": 0,
              "type": "integer"
            },
            "tool_calls": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "duration_ms",
            "input_tokens",
            "output_tokens",
            "tool_calls",
            "cost"
          ],
          "type": "object"
        },
        "modelResolution": {
          "additionalProperties": false,
          "properties": {
            "adapter": {
              "minLength": 2,
              "type": "string"
            },
            "model": {
              "minLength": 1,
              "type": "string"
            },
            "parameters": {
              "type": "object"
            },
            "profile_id": {
              "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
            },
            "prompt_digest": {
              "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/sha256"
            }
          },
          "required": [
            "profile_id",
            "adapter",
            "model",
            "parameters",
            "prompt_digest"
          ],
          "type": "object"
        },
        "nodeExecution": {
          "additionalProperties": false,
          "properties": {
            "attempt": {
              "minimum": 1,
              "type": "integer"
            },
            "completed_at": {
              "format": "date-time",
              "type": "string"
            },
            "duration_ms": {
              "minimum": 0,
              "type": "integer"
            },
            "error": {
              "$ref": "#/$defs/ErrorEnvelope"
            },
            "input": {
              "type": "object"
            },
            "node_id": {
              "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
            },
            "output": {
              "type": "object"
            },
            "started_at": {
              "format": "date-time",
              "type": "string"
            },
            "status": {
              "enum": [
                "completed",
                "failed",
                "cancelled"
              ]
            }
          },
          "required": [
            "node_id",
            "attempt",
            "status",
            "started_at",
            "completed_at",
            "duration_ms",
            "input",
            "output"
          ],
          "type": "object"
        },
        "provenance": {
          "additionalProperties": false,
          "properties": {
            "model_resolutions": {
              "items": {
                "$ref": "#/$defs/RunTrace/$defs/modelResolution"
              },
              "type": "array"
            },
            "redaction_policy_id": {
              "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
            },
            "tool_resolutions": {
              "items": {
                "$ref": "#/$defs/RunTrace/$defs/toolResolution"
              },
              "type": "array"
            }
          },
          "required": [
            "model_resolutions",
            "tool_resolutions",
            "redaction_policy_id"
          ],
          "type": "object"
        },
        "toolResolution": {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/sha256"
            },
            "tool_id": {
              "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
            },
            "version": {
              "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/semver"
            }
          },
          "required": [
            "tool_id",
            "version",
            "digest"
          ],
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "agent_version_digest": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/sha256"
        },
        "agent_version_id": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
        },
        "completed_at": {
          "format": "date-time",
          "type": "string"
        },
        "error": {
          "$ref": "#/$defs/ErrorEnvelope"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/RunEvent"
          },
          "minItems": 2,
          "type": "array"
        },
        "input": {
          "type": "object"
        },
        "metrics": {
          "$ref": "#/$defs/RunTrace/$defs/metrics"
        },
        "node_executions": {
          "items": {
            "$ref": "#/$defs/RunTrace/$defs/nodeExecution"
          },
          "type": "array"
        },
        "output": {
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/RunTrace/$defs/provenance"
        },
        "request_id": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/uuid"
        },
        "run_id": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/uuid"
        },
        "schema_version": {
          "const": "0.1.0"
        },
        "started_at": {
          "format": "date-time",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "cancelled"
          ]
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "request_id",
        "agent_version_id",
        "agent_version_digest",
        "status",
        "started_at",
        "completed_at",
        "input",
        "output",
        "events",
        "node_executions",
        "provenance",
        "metrics"
      ],
      "title": "RunTrace",
      "type": "object"
    },
    "ToolManifest": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "additionalProperties": false,
          "properties": {
            "ref": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "enum": [
                "builtin",
                "http",
                "openapi",
                "mcp",
                "sandbox"
              ]
            }
          },
          "required": [
            "type",
            "ref"
          ],
          "type": "object"
        },
        "approval_policy": {
          "enum": [
            "never",
            "configurable",
            "required"
          ]
        },
        "credential_refs": {
