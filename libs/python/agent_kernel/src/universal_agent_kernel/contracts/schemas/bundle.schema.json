    "Universal Agent Studio common contract definitions": {
      "$defs": {
        "credentialReference": {
          "additionalProperties": false,
          "properties": {
            "credential_ref": {
              "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/identifier"
