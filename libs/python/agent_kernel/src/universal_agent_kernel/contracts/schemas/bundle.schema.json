          "items": {
            "pattern": "^[a-z][a-z0-9.-]+:[a-z][a-z0-9.-]+$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "side_effect": {
          "enum": [
            "none",
            "read",
            "write",
            "destructive"
          ]
        },
        "version": {
          "$ref": "#/$defs/Universal Agent Studio common contract definitions/$defs/semver"
